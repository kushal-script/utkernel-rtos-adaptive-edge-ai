{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/KWS_TRON",
                "-B", "${workspaceFolder}/build/Debug",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/KWS_TRON/cmake/arm-none-eabi-gcc.cmake",
                "-G", "Unix Makefiles"
            ],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "CMake Configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/KWS_TRON",
                "-B", "${workspaceFolder}/build/Release",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/KWS_TRON/cmake/arm-none-eabi-gcc.cmake",
                "-G", "Unix Makefiles"
            ],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/Debug", "--parallel"],
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "CMake Configure (Debug)",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/Release", "--parallel"],
            "group": "build",
            "dependsOn": "CMake Configure (Release)",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash (ST-Link CLI)",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c", "port=SWD",
                "-d", "${workspaceFolder}/build/Debug/KWS_TRON.elf",
                "-rst"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "${workspaceFolder}/build"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
