{
    "configurations": [
        {
            "name": "STM32H533RE",
            "compilerPath": "/opt/homebrew/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m33",
                "-mthumb",
                "-mfpu=fpv5-sp-d16",
                "-mfloat-abi=hard"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "includePath": [
                "${workspaceFolder}/KWS_TRON/Core/Inc",
                "${workspaceFolder}/KWS_TRON/app",
                "${workspaceFolder}/KWS_TRON/audio",
                "${workspaceFolder}/KWS_TRON/Drivers/STM32H5xx_HAL_Driver/Inc",
                "${workspaceFolder}/KWS_TRON/Drivers/STM32H5xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/KWS_TRON/Drivers/CMSIS/Device/ST/STM32H5xx/Include",
                "${workspaceFolder}/KWS_TRON/Drivers/CMSIS/Include",
                "${workspaceFolder}/KWS_TRON/mtk3/include",
                "${workspaceFolder}/KWS_TRON/mtk3/include/sys/sysdepend/stm32_cube/nucleo_stm32h533",
                "${workspaceFolder}/KWS_TRON/tflm",
                "${workspaceFolder}/KWS_TRON/tflm/tensorflow/lite/micro"
            ],
            "defines": [
                "STM32H533xx",
                "USE_HAL_DRIVER",
                "TF_LITE_STATIC_MEMORY",
                "TF_LITE_DISABLE_X86_NEON"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/KWS_TRON"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
