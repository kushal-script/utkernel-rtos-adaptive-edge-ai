{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD — NUCLEO-H533RE)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "/opt/homebrew/bin/openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "${workspaceFolder}/.vscode/stm32h533.cfg"
            ],
            "openOCDLaunchCommands": [
                "transport select swd",
                "adapter speed 500"
            ],
            "executable": "${workspaceFolder}/build/Debug/KWS_TRON.elf",
            "cwd": "${workspaceFolder}",
            "device": "STM32H533RETx",
            "svdFile": "",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "rtos": "auto",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 250000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [
                    {
                        "type": "console",
                        "label": "ITM port 0 (DWT cycles)",
                        "port": 0
                    }
                ]
            },
            "preLaunchTask": "Build (Debug)"
        },
        {
            "name": "Flash + Reset (OpenOCD, no debug)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "/opt/homebrew/bin/openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "${workspaceFolder}/.vscode/stm32h533.cfg"
            ],
            "openOCDLaunchCommands": [
                "transport select swd",
                "adapter speed 500"
            ],
            "executable": "${workspaceFolder}/build/Debug/KWS_TRON.elf",
            "cwd": "${workspaceFolder}",
            "device": "STM32H533RETx",
            "noDebug": true,
            "preLaunchTask": "Build (Debug)"
        }
    ]
}
